# Required: TypeSafe API key (https://typesafe.ai)
TYPESAFE_API_KEY=

# Optional: name used in Jev classification prompts
# Example: Alex  or  the mailbox owner
MAILBOX_OWNER_NAME="the mailbox owner"

# Safety: default true in code too — set false only when ready to write
DRY_RUN=true

# Migration runner live writes (default false)
# APPLY_MIGRATION=false

# How many threads to process per main.py run
MAX_RESULTS=100

# Optional override of the default inbox query
# GMAIL_QUERY=

# Path to known-clients config (copy from clients.example.json)
KNOWN_CLIENTS_FILE=clients.local.json

# Gmail API retry budget
GMAIL_RETRY_ATTEMPTS=6
